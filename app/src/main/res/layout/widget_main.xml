<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_moon"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#6B6478"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_number"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="#241C4F"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#8A8398" />

    <TextView
        android:id="@+id/w_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:textSize="11sp"
        android:textColor="#9A93A8"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
